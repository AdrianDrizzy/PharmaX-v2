<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PharmaX.Persistence</RootNamespace>
  </PropertyGroup>

  <!-- installer\build.ps1 -TestBuild: an installer for trying PharmaX out,
       with an easier first administrator sign-in (ReferenceDataSeeder). -->
  <PropertyGroup Condition="'$(PharmaXTestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);PHARMAX_TEST_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmaX.Domain\PharmaX.Domain.csproj" />
    <ProjectReference Include="..\PharmaX.Application\PharmaX.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>


</Project>
