<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PharmaX.Desktop</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- Publishing. Self-contained because a pharmacy PC is not a
         machine anybody is going to install a .NET runtime on first,
         and the whole promise of the installer is that it is the only
         thing they have to run.

         Published as a folder rather than as a single file. The
         single-file build leaves the native libraries beside the
         executable anyway - e_sqlite3, the PDF renderer, the WPF
         graphics used by printing - unless they are made to
         self-extract on every start, and a till on a shop counter is
         the wrong place to trade reliable startup for a tidier folder.
         The installer hides the folder from whoever is using it. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Trimming is off deliberately: EF Core and the options binder
         both reach for types by reflection, and a trimmed build fails
         at the first query rather than at build time - which is the
         worst possible place to find out. -->

    <Version>1.0.18</Version>
    <FileVersion>1.0.18.0</FileVersion>
    <Company>PharmaX</Company>
    <Product>PharmaX</Product>

    <!-- The capsule from the BethRapha logo, on the logo's navy. -->
    <ApplicationIcon>Resources\pharmax.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Compiled in rather than installed: the icons are drawn from the
       Tabler icon font (MIT, see tabler-icons-LICENSE.txt), which no
       Windows has, and the window icon is the same file the executable
       carries. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\tabler-icons.ttf"
                      LogicalName="PharmaX.Desktop.Resources.tabler-icons.ttf" />
    <EmbeddedResource Include="Resources\pharmax.ico"
                      LogicalName="PharmaX.Desktop.Resources.pharmax.ico" />
    <None Include="Resources\tabler-icons-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Section 4.1: Desktop references the infrastructure projects because
       Program.cs registers their implementations in the container. No form,
       view or presenter may reference them; LayerRuleTests enforces that. -->
  <ItemGroup>
    <ProjectReference Include="..\PharmaX.Domain\PharmaX.Domain.csproj" />
    <ProjectReference Include="..\PharmaX.Application\PharmaX.Application.csproj" />
    <ProjectReference Include="..\PharmaX.Persistence\PharmaX.Persistence.csproj" />
    <ProjectReference Include="..\PharmaX.Adapters\PharmaX.Adapters.csproj" />
    <ProjectReference Include="..\PharmaX.Reporting\PharmaX.Reporting.csproj" />
    <ProjectReference Include="..\PharmaX.Sync\PharmaX.Sync.csproj" />
    <ProjectReference Include="..\PharmaX.Assistant\PharmaX.Assistant.csproj" />
  </ItemGroup>

  <!-- The reports assistant's engine (LLamaSharp and llama.cpp). Built with
       PharmaX and copied beside it into "assistant", but never referenced:
       it runs in a second PharmaX process, in a load context of its own,
       so none of its packages reach this project. Hence no output
       assembly, no assets and nothing passed on; and not this project's
       OutDir either, or a build into a shared folder would put the
       engine's own System.Text.Json beside PharmaX's. -->
  <ItemGroup>
    <ProjectReference Include="..\PharmaX.Assistant.Engine\PharmaX.Assistant.Engine.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      ExcludeAssets="all"
                      GlobalPropertiesToRemove="OutDir" />
  </ItemGroup>

  <!-- Copied, not added as items: an item added inside a target with
       %(RecursiveDir) in its metadata relabels every existing item of that
       type, which once sent PharmaX's own fonts into "assistant". -->
  <Target Name="FindAssistantEngine">
    <MSBuild Projects="..\PharmaX.Assistant.Engine\PharmaX.Assistant.Engine.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="OutDir;TargetFramework;RuntimeIdentifier;SelfContained;PublishDir">
      <Output TaskParameter="TargetOutputs" ItemName="_AssistantEngine" />
    </MSBuild>

    <PropertyGroup>
      <_AssistantEngineDir>@(_AssistantEngine->'%(RootDir)%(Directory)')</_AssistantEngineDir>
    </PropertyGroup>

    <ItemGroup>
      <_AssistantEngineFile Include="$(_AssistantEngineDir)**\*.*"
                            Exclude="$(_AssistantEngineDir)**\*.pdb" />
    </ItemGroup>
  </Target>

  <Target Name="CopyAssistantEngine" AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="FindAssistantEngine">
    <Copy SourceFiles="@(_AssistantEngineFile)"
          DestinationFiles="@(_AssistantEngineFile->'$(OutDir)assistant\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_AssistantEngineFile->'$(OutDir)assistant\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <Target Name="PublishAssistantEngine" AfterTargets="Publish"
          DependsOnTargets="FindAssistantEngine">
    <Copy SourceFiles="@(_AssistantEngineFile)"
          DestinationFiles="@(_AssistantEngineFile->'$(PublishDir)assistant\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- The first-run wizard only. It runs before the host is built, so
         it cannot ask the container for a connection, and its whole job
         is to tell the operator why the server will not answer. -->
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Settings.Configuration" />
  </ItemGroup>

  <!-- Section 7.1: without this the configuration file works in the IDE
       and vanishes in the deployed build. -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Copied for a developer running from bin, and deliberately NOT
         published. It holds a real database password, and PharmaX skips
         its first-run wizard when it finds one - so a published build
         carrying this file would ship somebody's credentials and come
         up already configured as their machine. -->
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
