<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Central package management (Directory.Packages.props) requires either a
       single source or explicit source mapping, otherwise NU1507 fails the
       build in the projects that treat warnings as errors. PharmaX takes no
       packages from a private feed, so pin the solution to nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
