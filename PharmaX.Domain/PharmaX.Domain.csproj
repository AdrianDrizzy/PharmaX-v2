<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PharmaX.Domain</RootNamespace>
  </PropertyGroup>

  <!-- Section 4.4: the innermost layers compile clean or not at all. -->
