    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Section 4.1: PharmaX.Domain references nothing. Not one project,
       not one NuGet package. LayerRuleTests enforces this. -->

</Project>
